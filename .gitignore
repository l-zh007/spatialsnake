# Python build and test artifacts
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Workflow/runtime output
.snakemake/
.snakemake_timestamp
results/
logs/
.test/results/
workflow/notebooks/.ipynb_checkpoints/

# Local environments and package caches
.conda_envs/
.conda_pkgs/
.venv/
venv/
env/
cache/

# Docker build files are tracked; packed environment artifacts stay out.
docker/*
!docker/test3/
!docker/test3/*.md
!docker/test3/*.py
!docker/test3/*.sh
!docker/test3/Dockerfile
!docker/test3/Dockerfile.dockerignore
!docker/test3/artifacts/
docker/test3/artifacts/*
!docker/test3/artifacts/.gitignore
!docker/test3/locks/
!docker/test3/locks/**

# R and editor state
**/.Rhistory
**/*.Rproj
**/.Rproj.user/
**/.RData
**/Rplots.pdf
.idea/
.vscode/
.DS_Store

# Local credentials and environment overrides
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
