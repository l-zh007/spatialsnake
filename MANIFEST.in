include *.txt
include Snakefile
recursive-include spatialsnake *.R
recursive-include spatialsnake *.py
recursive-include spatialsnake *.sh
recursive-include spatialsnake *.smk
recursive-include spatialsnake Snakefile
recursive-include spatialsnake *.yaml
prune build
prune dist
global-exclude __pycache__
global-exclude *.py[cod]
